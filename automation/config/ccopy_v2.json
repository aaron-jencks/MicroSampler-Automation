{
    "expected_conclusion": {
        "enabled": true
    },
    "harness": {
        "prefix": "bearssl-0.6/ccopy/v2/harness",
        "deployment_prefix": "bearssl-0.6/ccopy/v2/deploy",
        "uut": {
            "prefix": "bearssl-0.6/ccopy/v2/uut"
        }
    },
    "workbench": {
        "prefix": "bearssl-0.6/ccopy/v2/workbench",
        "source": {
            "contents": {
                "bearssl": "../apps/bearssl-0.6/src"
            }
        }
    },
    "llm": {
        "templates": {
            "files": {
                "instructions": "bearssl-0.6/ccopy/v2/prompts/instructions-prompt.txt",
                "initial_message": "bearssl-0.6/ccopy/v2/prompts/initial-prompt.txt",
                "stuck_message": "bearssl-0.6/ccopy/v2/prompts/stuck-prompt.txt",
                "wrong_conclusion_message": "bearssl-0.6/ccopy/v2/prompts/wrong-conclusion.txt",
                "target_prompt": "bearssl-0.6/ccopy/v2/prompts/target-prompt.txt"
            }
        }
    },
    "agents": {
        "hypothesis": {
            "templates": {
                "system": "bearssl-0.6/ccopy/v2/prompts/hypothesis/system-prompt.txt",
                "input": "bearssl-0.6/ccopy/v2/prompts/hypothesis/feedback-prompt.txt"
            }
        },
        "implementation": {
            "templates": {
                "system": "bearssl-0.6/ccopy/v2/prompts/implementation/system-prompt.txt",
                "input": "bearssl-0.6/ccopy/v2/prompts/implementation/feedback-prompt.txt"
            }
        },
        "summarization": {
            "templates": {
                "system": "bearssl-0.6/ccopy/v2/prompts/summarization/system-prompt.txt",
                "input": "bearssl-0.6/ccopy/v2/prompts/summarization/feedback-prompt.txt"
            }
        }
    },
    "logging": {
        "prefix": "bearssl-0.6/ccopy/v2/logs",
        "output": "ccopy_v2_output.log"
    },
    "final_report": {
        "prefix": "bearssl-0.6/ccopy/v2/final_report",
        "run_name": "ccopy_v2"
    }
}